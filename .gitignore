# Tooling
.codegraph/
.DS_Store

# Obsidian: share theme/plugin config, ignore per-machine UI state.
# workspace.json changes on every pane you open and would churn every commit.
docs/vault/.obsidian/workspace.json
docs/vault/.obsidian/workspace-mobile.json
docs/vault/.obsidian/cache

# Quarantine for dead files the agent may not delete (rm is denied by
# .claude/settings.json). A human empties this; nothing here is referenced.
.trash/

# T-00-018 canary hook evidence log (raw; the writeup lives in supervision-checks.md)
docs/vault/20-arquitectura/hook-canary.log

# Go scratch space, relocated out of %LOCALAPPDATA%\Temp so Windows Application
# Control does not block freshly linked test binaries (see Makefile).
apps/api/.gotmp/
