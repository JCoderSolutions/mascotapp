# Copy to .env for local development. Never commit .env — it is gitignored
# and denied to agents by .claude/settings.json.

PORT=8080
ENV=development
LOG_LEVEL=debug

# Local Postgres from docker-compose.yml. Production uses Neon with
# sslmode=verify-full (see ADR-0004); sslmode=disable is local-only.
DATABASE_URL=postgres://mascotapp:mascotapp_local_only@localhost:5432/mascotapp?sslmode=disable

# Local MinIO standing in for Cloudflare R2.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=mascotapp
S3_SECRET_KEY=mascotapp_local_only
S3_BUCKET=mascotapp-media

# OpenCode pilot (Phase 06 only — see ADR-0005). Keys live in the environment,
# never in the repo. Two providers on purpose: free model endpoints disappear
# without notice, so the flow must never depend on a single one.
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Rangos del front-end autorizado a reenviar X-Forwarded-For.
# Vacio = confiar en nadie = usar siempre el peer TCP.
# Ver docs/vault/20-arquitectura/variables-de-entorno.md
TRUSTED_PROXIES=

# Local Postgres from docker-compose. Required by `make migrate`, `make migrate-down`
# and `make db-reset`, which refuse to run without it rather than guess a database.
DATABASE_URL=postgres://mascotapp:mascotapp_local_only@localhost:5432/mascotapp?sslmode=disable

# Escape hatch for the container-backed suite when the Docker daemon is down.
# Refused outright when CI=true, so it can never hide a red suite in CI.
MASCOTAPP_SKIP_DOCKER_TESTS=


JWT_SECRET=